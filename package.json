{
  "name": "agent-commerce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run && playwright test && playwright test -c playwright.json-legacy.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test && playwright test -c playwright.json-legacy.config.ts",
    "preserver": "npm run build:server",
    "server": "node dist-server/server/index.js",
    "dev:all": "echo 'Run terminal A: npm run server  |  terminal B: npm run dev'",
    "premcp": "npm run build:server",
    "mcp": "node dist-server/mcp/stdio.js",
    "premcp:http": "npm run build:server",
    "mcp:http": "node dist-server/mcp/http.js",
    "pretest:mcp:http": "npm run build:server",
    "test:mcp:http": "vitest run tests/mcp/http.smoke.test.ts",
    "openapi": "vitest run tests/server/openapi.test.ts",
    "openapi:check": "vitest run tests/server/openapi-check.test.ts",
    "premigrate": "npm run build:server",
    "migrate": "node dist-server/repo/migrate-cli.js",
    "docs:gen": "tsx scripts/gen-docs-reference.ts",
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run docs:gen && git diff --exit-code -- docs/reference/api.generated.md docs/reference/mcp-tools.generated.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.8"
  }
}
