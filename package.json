{
  "name": "agent-commerce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server": "node --experimental-strip-types --experimental-transform-types src/server/index.ts",
    "dev:all": "echo 'Run terminal A: npm run server  |  terminal B: npm run dev'",
    "mcp": "node --experimental-strip-types --experimental-transform-types src/mcp/stdio.ts",
    "mcp:http": "node --experimental-strip-types --experimental-transform-types src/mcp/http.ts",
    "openapi": "vitest run tests/server/openapi.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
