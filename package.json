{
  "name": "agent-commerce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "preserver": "npm run build:server",
    "server": "node dist-server/server/index.js",
    "dev:all": "echo 'Run terminal A: npm run server  |  terminal B: npm run dev'",
    "premcp": "npm run build:server",
    "mcp": "node dist-server/mcp/stdio.js",
    "premcp:http": "npm run build:server",
    "mcp:http": "node dist-server/mcp/http.js",
    "openapi": "vitest run tests/server/openapi.test.ts",
    "openapi:check": "vitest run tests/server/openapi-check.test.ts",
    "premigrate": "npm run build:server",
    "migrate": "node dist-server/repo/migrate-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
