# Daily SQLite backup at 02:15 UTC (ACP-38).
# Install: crontab -e  → paste the line (adjust path / COMPOSE_PROJECT_NAME).
# Logs append to deploy/backups/cron.log; non-zero exit leaves a trail in that log.
#
# 15 2 * * * cd /path/to/agent-commerce && COMPOSE_PROJECT_NAME=agent-commerce BACKUP_RETAIN=7 ./deploy/backup.sh >>./deploy/backups/cron.log 2>&1
15 2 * * * cd /path/to/agent-commerce && COMPOSE_PROJECT_NAME=agent-commerce BACKUP_RETAIN=7 ./deploy/backup.sh >>./deploy/backups/cron.log 2>&1
